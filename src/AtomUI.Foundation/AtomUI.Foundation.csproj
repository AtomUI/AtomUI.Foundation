<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(AtomUIFoundationTargetFrameworks)</TargetFrameworks>
        <RootNamespace>AtomUI.Foundation</RootNamespace>
        <!-- Run trim and AOT analyzers on every build; consumer publishes remain the acceptance evidence. -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUI.Foundation.Generator/AtomUI.Foundation.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="AtomUIFoundationVersion" Value="$(AtomUIFoundationVersion)" />
    </ItemGroup>
    <!-- Public API baseline: Shipped = the 1.0.4 release surface; new symbols go to Unshipped until the next release. -->
    <PropertyGroup>
        <!-- Undeclared new API (RS0016) and removed shipped API (RS0017) fail the build. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
